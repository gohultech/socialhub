<% if resource.errors.any? %>
  <% error_count = resource.errors.attribute_names.uniq.length %>
  <div class="auth-error-summary" role="alert" aria-live="assertive">
    <span class="auth-error-summary-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle-fill"></i></span>
    <div>
      <strong>Please check your details</strong>
      <span><%= error_count %> <%= "field".pluralize(error_count) %> need your attention.</span>
    </div>
  </div>
<% end %>
