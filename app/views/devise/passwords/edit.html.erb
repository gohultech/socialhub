<div class="auth-legacy-page">
<h2>Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-legacy-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, "New password" %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <% password_has_error = resource.errors[:password].present? %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: ("auth-input-error" if password_has_error), aria: (password_has_error ? { invalid: true, describedby: "user_password_error" } : {}) %></p>
    <%= render "devise/shared/field_error", resource: resource, field: :password, input_id: "user_password" %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Confirm new password" %></p>
    <% confirmation_has_error = resource.errors[:password_confirmation].present? %>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: ("auth-input-error" if confirmation_has_error), aria: (confirmation_has_error ? { invalid: true, describedby: "user_password_confirmation_error" } : {}) %></p>
    <%= render "devise/shared/field_error", resource: resource, field: :password_confirmation, input_id: "user_password_confirmation" %>
  </div>

  <div class="actions">
    <%= f.submit "Change my password" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
</div>
