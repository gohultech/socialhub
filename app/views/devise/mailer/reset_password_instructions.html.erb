<% reset_url = edit_password_url(@resource, reset_password_token: @token) %>
<style>
  @media only screen and (max-width: 620px) {
    .email-shell { width: 100% !important; }
    .email-outer { padding: 20px 12px !important; }
    .email-header { padding: 22px 20px !important; }
    .email-nav { display: none !important; }
    .email-card-padding { padding: 34px 24px !important; }
    .email-heading { font-size: 28px !important; }
    .email-button { display: block !important; width: auto !important; }
    .email-button a { display: block !important; padding: 16px 18px !important; text-align: center !important; }
    .email-footer { padding-right: 20px !important; padding-left: 20px !important; }
  }
</style>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0;padding:0;background:#eef2f8;font-family:Arial,Helvetica,sans-serif;color:#eaf0ff;">
  <tr>
    <td align="center" class="email-outer" style="padding:34px 16px;background:#eef2f8;">
      <table role="presentation" width="620" cellpadding="0" cellspacing="0" border="0" class="email-shell" style="width:100%;max-width:620px;margin:0 auto;">
        <tr>
          <td class="email-header" style="padding:25px 28px;background:#091328;border:1px solid #192a4b;border-bottom:0;border-radius:18px 18px 0 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td valign="middle" style="white-space:nowrap;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" width="38" height="38" style="width:38px;height:38px;border:1px solid #628bff;border-radius:12px;background:#4d77e9;color:#ffffff;font-size:20px;font-weight:bold;line-height:38px;">✦</td>
                      <td style="padding-left:11px;color:#f8faff;font-size:20px;font-weight:bold;letter-spacing:-.5px;">Circle<span style="color:#88adff;">Hub</span></td>
                    </tr>
                  </table>
                </td>
                <td align="right" valign="middle" class="email-nav" style="color:#8495b5;font-size:10px;letter-spacing:.2px;white-space:nowrap;">People&nbsp;&nbsp;•&nbsp;&nbsp; Communities&nbsp;&nbsp;•&nbsp;&nbsp; Better Together</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td height="4" style="height:4px;background:#4c8dff;background:linear-gradient(90deg,#4c8dff 0%,#8b72ee 52%,#e78bbd 100%);font-size:0;line-height:0;">&nbsp;</td>
        </tr>
        <tr>
          <td style="padding:1px;background:#334b91;border-radius:0 0 18px 18px;box-shadow:0 16px 40px rgba(39,61,126,.16);">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background:#101c35;border-radius:0 0 17px 17px;">
              <tr>
                <td class="email-card-padding" style="padding:42px 46px 34px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" width="44" height="44" style="width:44px;height:44px;border:1px solid #5578c9;border-radius:13px;background:#1e3159;color:#a9c4ff;font-size:20px;font-weight:bold;line-height:44px;">⌑</td>
                    </tr>
                  </table>
                  <p style="margin:20px 0 10px;color:#91b5ff;font-size:10px;font-weight:bold;letter-spacing:2px;line-height:1.4;">PASSWORD RESET</p>
                  <h1 class="email-heading" style="margin:0 0 22px;color:#f7f9ff;font-size:32px;line-height:1.15;letter-spacing:-.8px;font-weight:700;">Reset your <span style="color:#8aaaff;background:linear-gradient(90deg,#6da5ff 0%,#a17bed 55%,#e88dbb 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">CircleHub</span> password</h1>
                  <p style="margin:0 0 16px;color:#e0e8f8;font-size:15px;line-height:1.65;">Hi <%= @resource.email %>,</p>
                  <p style="margin:0 0 12px;color:#adbad2;font-size:15px;line-height:1.7;">Someone requested a link to change your CircleHub password.</p>
                  <p style="margin:0 0 29px;color:#adbad2;font-size:15px;line-height:1.7;">No worries — you can securely reset your password and get back to what matters: your community.</p>
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="email-button" style="margin:0 0 30px;">
                    <tr>
                      <td align="center" style="border-radius:11px;background:#6b7cf2;background:linear-gradient(100deg,#4c8dff 0%,#806eea 55%,#dd82b7 100%);box-shadow:0 8px 18px rgba(92,113,235,.22);">
                        <%= link_to "Reset my password  →", reset_url, style: "display:inline-block;padding:16px 26px;border:1px solid #9eb4ff;border-radius:11px;background:#6b7cf2;background:linear-gradient(100deg,#4c8dff 0%,#806eea 55%,#dd82b7 100%);color:#ffffff;font-size:14px;font-weight:bold;line-height:1;text-decoration:none;" %>
                      </td>
                    </tr>
                  </table>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0 0 31px;background:#18294a;border:1px solid #35558e;border-radius:14px;">
                    <tr>
                      <td valign="top" width="38" style="width:38px;padding:18px 0 18px 18px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                          <tr><td align="center" width="32" height="32" style="width:32px;height:32px;border-radius:10px;background:#243b69;color:#9fbdff;font-size:15px;line-height:32px;">♢</td></tr>
                        </table>
                      </td>
                      <td style="padding:18px 18px 18px 12px;">
                        <p style="margin:0 0 7px;color:#d8e4ff;font-size:13px;font-weight:bold;line-height:1.4;">Your account is secure</p>
                        <p style="margin:0;color:#9eaecc;font-size:12px;line-height:1.65;">If you didn't request a password reset, you can safely ignore this email. Your password will not change unless you use the reset link and create a new one.</p>
                      </td>
                    </tr>
                  </table>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0 0 23px;">
                    <tr><td style="border-top:1px solid #2b3d61;font-size:0;line-height:0;">&nbsp;</td></tr>
                  </table>
                  <p align="center" style="margin:0 0 11px;color:#91b5ff;font-size:10px;font-weight:bold;letter-spacing:1.8px;line-height:1.4;">OR COPY THE LINK</p>
                  <p style="margin:0 0 12px;color:#92a2be;font-size:12px;line-height:1.6;">Button not working? Copy and paste this link into your browser:</p>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background:#0b172d;border:1px solid #2d4777;border-radius:9px;">
                    <tr><td style="padding:12px 13px;word-break:break-all;overflow-wrap:anywhere;color:#94b5ff;font-size:11px;line-height:1.55;"><%= link_to reset_url, reset_url, style: "color:#94b5ff;text-decoration:none;" %></td></tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td style="padding:22px 46px 24px;border-top:1px solid #26385c;background:#0d172b;border-radius:0 0 17px 17px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" width="34" height="34" style="width:34px;height:34px;border:1px solid #375487;border-radius:11px;background:#182b4d;color:#9bb8ff;font-size:15px;line-height:34px;">✦</td>
                      <td style="padding-left:12px;">
                        <p style="margin:0 0 4px;color:#e5ecfb;font-size:14px;font-weight:bold;line-height:1.4;">Your circle is waiting.</p>
                        <p style="margin:0;color:#8394b3;font-size:12px;line-height:1.55;">Reconnect with your communities, conversations, and people on CircleHub.</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td align="center" class="email-footer" style="padding:27px 20px 5px;color:#7c8ca6;font-size:11px;line-height:1.8;">
            <strong style="color:#31476d;font-size:13px;">CircleHub</strong><br>
            A place to connect, discover, and belong. <span style="color:#e889ac;">♥</span><br>
            © 2026 CircleHub. All rights reserved.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
