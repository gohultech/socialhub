<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">

    <%= link_to "SocialHub", root_path, class: "navbar-brand" %>

    <div class="collapse navbar-collapse">
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Posts", posts_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Saved", saved_posts_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Search", search_path, class: "nav-link" %>
        </li>

        <% if user_signed_in? %>

          <% unread = current_user.notifications.where(read: false).count %>

          <li class="nav-item">
            <%= link_to notifications_path, class: "nav-link" do %>
              Notifications

              <% if unread > 0 %>
        <span class="badge bg-danger">
          <%= unread %>
        </span>
              <% end %>
            <% end %>
          </li>

        <% end %>

        <li class="nav-item">
          <%= link_to "Profile", profile_path, class: "nav-link" %>
        </li>

        <% if user_signed_in? %>
          <li class="nav-item">
            <%= button_to "Logout",
                          destroy_user_session_path,
                          method: :delete,
                          class: "btn btn-link nav-link" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Register", new_user_registration_path, class: "btn btn-primary ms-2" %>
          </li>
        <% end %>

      </ul>
    </div>

  </div>
</nav>