<nav class="navbar navbar-expand-lg social-navbar <%= "home-feed-navbar" if user_signed_in? && controller_name == "home" && action_name == "index" %>">
  <div class="container">

    <!-- Brand -->

    <%= link_to root_path,
                class: "navbar-brand social-brand" do %>

      <span class="brand-icon">
        <i class="bi bi-people-fill"></i>
      </span>

      <span>
        CircleHub
      </span>

    <% end %>


    <!-- Mobile Toggle -->

    <button class="navbar-toggler border-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar">

      <i class="bi bi-list fs-3"></i>

    </button>


    <!-- Navigation -->

    <div class="collapse navbar-collapse"
         id="mainNavbar">

      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

        <% if user_signed_in? %>

        <li class="nav-item">

          <%= link_to root_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-house me-1"></i>
            Home

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to posts_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-grid me-1"></i>
            Posts

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to profile_path(anchor: "profile-saved"),
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-bookmark me-1"></i>
            Saved

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to search_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-search me-1"></i>
            Search

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to messages_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-chat-dots me-1"></i>
            Messages

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to notifications_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-bell me-1"></i>
            Notifications

          <% end %>

        </li>


        <li class="nav-item">

          <%= link_to profile_path,
                      class: "nav-link social-nav-link" do %>

            <i class="bi bi-person-circle me-1"></i>
            Profile

          <% end %>

        </li>


        <li class="nav-item ms-lg-2">

          <%= button_to destroy_user_session_path,
                        method: :delete,
                        class: "btn social-logout-btn" do %>

            <i class="bi bi-box-arrow-right me-1"></i>
            Logout

          <% end %>

        </li>

        <% else %>

          <li class="nav-item ms-lg-2">

            <%= link_to new_user_session_path,
                        class: "nav-link social-login-link" do %>

              Login

            <% end %>

          </li>


          <li class="nav-item">

            <%= link_to new_user_registration_path,
                        class: "btn social-get-started" do %>

              Get Started
              <i class="bi bi-arrow-right ms-1"></i>

            <% end %>

          </li>

        <% end %>

      </ul>

    </div>

  </div>
</nav>
