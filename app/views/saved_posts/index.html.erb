<div class="bg-light min-vh-100">

  <!-- ================= SAVED POSTS PAGE ================= -->
  <section class="py-5">

    <div class="container">

      <!-- ================= PAGE HEADER ================= -->

      <div class="d-flex flex-column flex-md-row
                  align-items-md-center
                  justify-content-between gap-3 mb-4">

        <div>

          <div class="d-flex align-items-center gap-2 mb-2">

            <div class="bg-warning bg-opacity-10 text-warning
                        rounded-3 p-2">

              <i class="bi bi-bookmark-fill fs-5"></i>

            </div>

            <span class="text-primary fw-semibold">
              CircleHub
            </span>

          </div>


          <h1 class="fw-bold mb-1">
            Saved Posts
          </h1>


          <p class="text-muted mb-0">
            Posts you've saved to revisit later.
          </p>

        </div>


        <!-- Back to Posts -->
        <%= link_to posts_path,
                    class: "btn btn-outline-primary
                            rounded-pill px-4" do %>

          <i class="bi bi-arrow-left me-1"></i>
          Back to Posts

        <% end %>

      </div>


      <!-- ================= SAVED POSTS ================= -->

      <% if @posts.any? %>


        <div class="row justify-content-center">

          <div class="col-xl-8 col-lg-9">


            <!-- Count -->
            <div class="d-flex align-items-center
                        justify-content-between mb-3">

              <div>

                <h5 class="fw-bold mb-0">
                  Your Saved Posts
                </h5>

                <small class="text-muted">
                  <%= pluralize(@posts.count, "saved post") %>
                </small>

              </div>

            </div>


            <!-- ================= POST LOOP ================= -->

            <% @posts.each do |post| %>


              <!-- Saved Post Card -->
              <div class="card border-0 shadow-sm
                          rounded-4 mb-4 overflow-hidden">

                <div class="card-body p-4">


                  <!-- ================= POST HEADER ================= -->

                  <div class="d-flex align-items-center
                              justify-content-between mb-3">


                    <div class="d-flex align-items-center gap-3">


                      <!-- Avatar -->
                      <% if post.user.profile&.avatar&.attached? %>
                        <%= image_tag post.user.profile.avatar, class: "posts-index-avatar", alt: "#{post.user.profile.username || post.user.email.split('@').first}'s avatar" %>
                      <% else %>
                        <%= image_tag "default_avatar.png", class: "posts-index-avatar", alt: "Default avatar" %>
                      <% end %>


                      <!-- User -->
                      <div>

                        <h6 class="fw-bold mb-0">

                          <%= post.user.profile&.username ||
                                post.user.email.split("@").first %>

                        </h6>


                        <small class="text-muted">

                          <i class="bi bi-clock me-1"></i>

                          <%= time_ago_in_words(post.created_at) %> ago

                        </small>

                      </div>

                    </div>


                    <!-- Saved Badge -->
                    <span class="badge bg-warning bg-opacity-10
                                 text-warning rounded-pill px-3 py-2">

                      <i class="bi bi-bookmark-fill me-1"></i>
                      Saved

                    </span>

                  </div>


                  <!-- ================= POST CONTENT ================= -->

                  <div class="mb-3">

                    <p class="text-dark lh-lg mb-0">

                      <%= render_mentions(
                            render_hashtags(post.content)
                          ) %>

                    </p>

                  </div>


                  <!-- ================= POST IMAGE ================= -->

                  <% if post.image.attached? %>

                    <div class="mb-3">

                      <%= image_tag post.image,
                                    class: "img-fluid rounded-4 w-100" %>

                    </div>

                  <% end %>


                  <!-- ================= FOOTER ================= -->

                  <div class="border-top pt-3">

                    <div class="d-flex align-items-center
                                justify-content-between">


                      <!-- Post Date -->
                      <small class="text-muted">

                        <i class="bi bi-calendar3 me-1"></i>

                        <%= post.created_at.strftime("%d %b %Y") %>

                      </small>


                      <!-- View Post -->
                      <%= link_to post_path(post),
                                  class: "btn btn-sm
                                          btn-outline-primary
                                          rounded-pill px-3" do %>

                        <i class="bi bi-eye me-1"></i>
                        View Post

                      <% end %>

                    </div>

                  </div>


                </div>

              </div>


            <% end %>


          </div>

        </div>


      <% else %>


        <!-- ================= EMPTY STATE ================= -->

        <div class="row justify-content-center">

          <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

              <div class="card-body text-center py-5">


                <!-- Icon -->
                <div class="bg-warning bg-opacity-10 text-warning
                            rounded-circle d-inline-flex
                            align-items-center
                            justify-content-center mb-4"
                     style="width: 80px; height: 80px;">

                  <i class="bi bi-bookmark fs-2"></i>

                </div>


                <h3 class="fw-bold mb-2">
                  No Saved Posts
                </h3>


                <p class="text-muted mb-4">

                  Posts you save will appear here.
                  Save something interesting and come back later.

                </p>


                <%= link_to posts_path,
                            class: "btn btn-primary btn-lg
                                    rounded-pill px-4 shadow-sm" do %>

                  <i class="bi bi-grid me-2"></i>
                  Explore Posts

                <% end %>


              </div>

            </div>

          </div>

        </div>


      <% end %>


    </div>

  </section>

</div>
