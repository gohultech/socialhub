<div class="posts-index-page">
  <%= render "shared/authenticated_topbar", active_section: :home %>
  <%= render "shared/authenticated_sidebar", active_section: :home %>

  <main class="posts-index-main">

  <!-- ================= PAGE HEADER ================= -->
  <section class="py-5">
    <div class="container">

      <div class="d-flex flex-column flex-md-row
                  align-items-md-center
                  justify-content-between gap-3 mb-4">

        <div>

          <div class="d-flex align-items-center gap-2 mb-2">

            <div class="bg-primary bg-opacity-10 text-primary
                        rounded-3 p-2">

              <i class="bi bi-grid-3x3-gap-fill fs-5"></i>

            </div>

            <span class="text-primary fw-semibold">
              CircleHub
            </span>

          </div>

          <h1 class="fw-bold mb-1">
            My Posts
          </h1>

          <p class="text-muted mb-0">
            Manage and share your posts with the community.
          </p>

        </div>


        <!-- New Post -->
        <%= link_to new_post_path,
                    class: "btn btn-primary btn-lg rounded-pill px-4 shadow-sm" do %>

          <i class="bi bi-plus-circle me-2"></i>
          New Post

        <% end %>

      </div>


      <!-- ================= POSTS ================= -->

      <% if @posts.any? %>

        <div class="row justify-content-center">

          <div class="col-xl-8 col-lg-9">


            <!-- Posts Count -->
            <div class="d-flex align-items-center
                        justify-content-between mb-3">

              <div>

                <h5 class="fw-bold mb-0">
                  Your Posts
                </h5>

                <small class="text-muted">
                  <%= pluralize(@posts.count, "post") %>
                </small>

              </div>

            </div>


            <!-- ================= POST LOOP ================= -->

            <% @posts.each do |post| %>


              <!-- Post Card -->
              <div class="card border-0 shadow-sm rounded-4
                          mb-4 overflow-hidden">

                <div class="card-body p-4">


                  <!-- ================= POST HEADER ================= -->

                  <div class="d-flex align-items-center
                              justify-content-between mb-3">


                    <div class="d-flex align-items-center gap-3">


                      <!-- Avatar -->
                      <% if current_user.profile&.avatar&.attached? %>
                        <%= image_tag current_user.profile.avatar, class: "posts-index-avatar", alt: "Your avatar" %>
                      <% else %>
                        <%= image_tag "default_avatar.png", class: "posts-index-avatar", alt: "Default avatar" %>
                      <% end %>


                      <!-- Post Info -->
                      <div>

                        <h6 class="fw-bold mb-0">
                          My Post
                        </h6>

                        <small class="text-muted">

                          <i class="bi bi-clock me-1"></i>

                          <%= time_ago_in_words(post.created_at) %> ago

                        </small>

                      </div>

                    </div>


                    <!-- Post Menu Icon -->
                    <div class="text-muted">

                      <i class="bi bi-three-dots fs-5"></i>

                    </div>

                  </div>


                  <!-- ================= POST CONTENT ================= -->

                  <div class="mb-3">

                    <p class="text-dark lh-lg mb-0">

                      <%= render_mentions(
                            render_hashtags(post.content)
                          ) %>

                    </p>

                  </div>


                  <!-- ================= POST IMAGE ================= -->

                  <% if post.image.attached? %>

                    <div class="mb-3">

                      <%= image_tag post.image,
                                    class: "img-fluid rounded-4 w-100" %>

                    </div>

                  <% end %>


                  <!-- ================= POST FOOTER ================= -->

                  <div class="border-top pt-3">

                    <div class="d-flex
                                align-items-center
                                justify-content-between">


                      <!-- Created Time -->
                      <div class="text-muted small">

                        <i class="bi bi-calendar3 me-1"></i>

                        <%= post.created_at.strftime("%d %b %Y") %>

                      </div>


                      <!-- Actions -->
                      <div class="d-flex gap-2">


                        <!-- Edit -->
                        <%= link_to edit_post_path(post),
                                    class: "btn btn-sm
                                            btn-outline-primary
                                            rounded-pill px-3" do %>

                          <i class="bi bi-pencil me-1"></i>
                          Edit

                        <% end %>


                        <!-- Delete -->
                        <%= link_to post_path(post),
                                    data: {
                                      turbo_method: :delete,
                                      turbo_confirm: "Are you sure you want to delete this post?"
                                    },
                                    class: "btn btn-sm
                                            btn-outline-danger
                                            rounded-pill px-3" do %>

                          <i class="bi bi-trash me-1"></i>
                          Delete

                        <% end %>

                      </div>

                    </div>

                  </div>


                </div>

              </div>


            <% end %>


          </div>

        </div>


      <% else %>


        <!-- ================= EMPTY STATE ================= -->

        <div class="row justify-content-center">

          <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

              <div class="card-body text-center py-5">


                <!-- Icon -->
                <div class="bg-primary bg-opacity-10 text-primary
                            rounded-circle d-inline-flex
                            align-items-center
                            justify-content-center mb-4"
                     style="width: 80px; height: 80px;">

                  <i class="bi bi-journal-text fs-2"></i>

                </div>


                <h3 class="fw-bold mb-2">
                  No Posts Yet
                </h3>


                <p class="text-muted mb-4">

                  You haven't created any posts yet.
                  Start sharing your thoughts with the community.

                </p>


                <%= link_to new_post_path,
                            class: "btn btn-primary btn-lg
                                    rounded-pill px-4 shadow-sm" do %>

                  <i class="bi bi-plus-circle me-2"></i>
                  Create Your First Post

                <% end %>


              </div>

            </div>

          </div>

        </div>


      <% end %>


    </div>
  </section>

  </main>
</div>
