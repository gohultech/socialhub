<div class="simple-dashboard-page">
  <%= render "shared/authenticated_topbar", active_section: :home %>
  <%= render "shared/authenticated_sidebar", active_section: :home %>

  <main class="simple-dashboard-main">
    <div class="simple-dashboard-card">

    <h2 class="text-center mb-4">
      Edit Post
    </h2>

    <%= form_with model: @post, local: true do |f| %>

      <div class="mb-3">
        <%= f.label :content %>

        <%= f.text_area :content,
                        class: "form-control",
                        rows: 6 %>
      </div>

      <%= f.submit "Update Post",
                   class: "btn btn-primary w-100" %>

    <% end %>

    </div>
  </main>
</div>
