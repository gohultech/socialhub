<div class="container mt-5">

  <div class="card shadow p-4">

    <h2 class="mb-4">My Profile</h2>

    <div class="row text-center mb-4">

      <div class="col">
        <h4><%= current_user.posts.count %></h4>
        <small class="text-muted">Posts</small>
      </div>

      <div class="col">
        <h4><%= current_user.followers.count %></h4>
        <small class="text-muted">Followers</small>
      </div>

      <div class="col">
        <h4><%= current_user.following.count %></h4>
        <small class="text-muted">Following</small>
      </div>

    </div>

    <hr>

    <% if @profile.avatar.attached? %>
      <%= image_tag @profile.avatar,
                    class: "rounded-circle",
                    width: 150,
                    height: 150 %>
    <% else %>
      <%= image_tag "default_avatar.png",
                    class: "rounded-circle",
                    width: 150,
                    height: 150 %>
    <% end %>

    <p>
      <strong>Username:</strong>
      <%= @profile.username %>
    </p>

    <p>
      <strong>Full Name:</strong>
      <%= @profile.full_name.presence || "-" %>
    </p>

    <p>
      <strong>Bio:</strong>
      <%= @profile.bio.presence || "-" %>
    </p>

    <p>
      <strong>Website:</strong>
      <%= @profile.website.presence || "-" %>
    </p>

    <p>
      <strong>Location:</strong>
      <%= @profile.location.presence || "-" %>
    </p>

    <%= link_to "Edit Profile",
                edit_profile_path,
                class: "btn btn-primary mt-3" %>

  </div>

</div>